# ____REMOVE THIS LINE AFTER RENAMING sample.env to .env ____

# Optional saved WhatsApp session. Leave empty to use local pairing.
SESSION_ID=
# Optional persistent directory for the multi-file WhatsApp session.
# Set this to a mounted/persistent volume path on hosts that reset the app filesystem.
SESSION_PATH=./session

# PUT YOUR REMOVE BACKGROUND KEY (Optional)
REMOVEBG_KEY=

# Telegram bot token for the .tgstk sticker importer (Optional)
TELEGRAM_BOT_TOKEN=

PORT=5000

# Optional number for automatic local pairing on startup.
PAIRING_NUMBER=


# Use One Of Following:
# Database Configuration (Optional but recommended)
# Leave empty to use JSON file storage

# MongoDB (Optional)
MONGO_URL=

# PostgreSQL (Optional)
POSTGRES_URL=

# MySQL (Optional)
MYSQL_URL=

# SQLite Path (Optional)
# Example: DB_URL=./data/baileys.db
DB_URL=

PREFIXES=.,!,/,#

PACKNAME=jam-md

BOT_NAME=jam-md

# AI providers (optional; can also be configured with the owner-only .aikey command)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
XAI_API_KEY=
AI_PROVIDER=auto
XAI_MODEL=grok-3-mini
ENABLE_LEGACY_AI=false
SESSION_GIST_OWNER=stormfiber

# Optional feature providers
TENOR_API_KEY=
WEATHER_API_KEY=
NEWS_API_KEY=
FREEIMAGE_API_KEY=
ACRCLOUD_HOST=identify-eu-west-1.acrcloud.com
ACRCLOUD_ACCESS_KEY=
ACRCLOUD_ACCESS_SECRET=

OWNER_NUMBER=923000000000

COMMAND_MODE=private

BOT_OWNER=Jaiton

TIMEZONE=Asia/Karachi
