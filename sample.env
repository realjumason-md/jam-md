# ____REMOVE THIS LINE AFTER RENAMING sample.env to .env ____

# Optional saved WhatsApp session. Leave empty to use the web pairing form.
SESSION_ID=

# PUT YOUR REMOVE BACKGROUND KEY (Optional)
REMOVEBG_KEY=

PORT=5000

# Pairing codes are requested from the bot web page when no session is available.


# Use One Of Following:
# Database Configuration (Optional but recommended)
# Leave empty to use JSON file storage

# MongoDB (Optional)
MONGO_URL=

# PostgreSQL (Optional)
POSTGRES_URL=

# MySQL (Optional)
MYSQL_URL=

# SQLite Path (Optional)
# Example: DB_URL=./data/baileys.db
DB_URL=

PREFIXES=.,!,£,✨️,👀

PACKNAME=jam-md

BOT_NAME=jam-md

# AI providers (optional; can also be configured with the owner-only .aikey command)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GROQ_API_KEY=
XAI_API_KEY=
AI_PROVIDER=auto
XAI_MODEL=grok-3-mini

OWNER_NUMBER=923000000000

COMMAND_MODE=private

BOT_OWNER=Jaiton

TIMEZONE=Asia/Karachi
